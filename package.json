{
  "name": "shop-dashboard",
  "version": "0.1.0",
  "private": true,
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:markdown": "markdownlint-cli2 \"**/*.md\"",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "npm run test:unit",
    "test:unit": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check:dead-code": "knip",
    "check:cycles": "madge --circular --extensions ts,tsx --ts-config tsconfig.json --exclude '^tailwindcss$' src",
    "check:architecture": "depcruise src",
    "security:audit": "npm audit --audit-level=high",
    "quality:sonar": "sonar-scanner",
    "validate": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run check:dead-code && npm run check:cycles && npm run check:architecture && npm run build"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@tanstack/react-query": "^5.101.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.28.0",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "babel-plugin-react-compiler": "1.0.0",
    "dependency-cruiser": "^18.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "knip": "^6.31.0",
    "lint-staged": "^17.3.0",
    "madge": "^8.0.0",
    "markdownlint-cli2": "^0.23.2",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sonar-scanner": "^3.1.0",
    "tailwindcss": "^4",
    "typescript": "^7",
    "vitest": "^4.1.10",
    "vitest-axe": "^0.1.0"
  }
}
